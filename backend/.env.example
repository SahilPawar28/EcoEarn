# MongoDB Atlas connection string (free tier): https://www.mongodb.com/cloud/atlas
MONGO_URI=

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

PORT=5000

# Comma-separated list of allowed frontend origins for CORS
FRONTEND_URL=http://localhost:5173
