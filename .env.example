# Sepolia RPC endpoint (free tier): https://www.alchemy.com or https://www.infura.io
SEPOLIA_RPC_URL=

# Private key of the deployer wallet (fund it with free Sepolia ETH from a faucet,
# e.g. https://sepoliafaucet.com). NEVER commit this file or use a wallet holding real funds.
PRIVATE_KEY=

# Optional: from https://etherscan.io/myapikey, used to verify the contract source on Etherscan
ETHERSCAN_API_KEY=
