# URL of the deployed backend (Render, etc). Defaults to http://localhost:5000 if unset.
VITE_API_URL=http://localhost:5000

# Optional override for the deployed RewardToken contract address.
# Normally you don't need this: `npm run deploy:sepolia` (from the repo root)
# writes it automatically into src/contract-address.json.
VITE_CONTRACT_ADDRESS=
